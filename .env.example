# =============================================================================
# Configurações Gerais do Django
# =============================================================================
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=*
DATABASE_URL=postgres://migrantia_user:migrantia_password@localhost:5433/migrantia

# =============================================================================
# 🧠 SELEÇÃO ATIVA DE INTELIGÊNCIA ARTIFICIAL (Switches Principais)
# =============================================================================
# Basta trocar o valor destas variáveis para alternar todo o comportamento de IA.
# Opções de provedor: openai | ollama (ou llama) | google (ou gemini)

# 1. Provedor e Modelo Ativos para LLM (Chat / RAG / Geração de Respostas)
AI_LLM_PROVIDER=openai
AI_LLM_MODEL=gpt-4o-mini

# 2. Provedor e Modelo Ativos para Embeddings (Vetorização de Documentos / Busca)
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small


# Switch Mestre Opcional (define LLM e Embedding juntos se não especificados acima):
# AI_PROVIDER=openai

# =============================================================================
# 1. Provedor: OpenAI
# =============================================================================
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536

# =============================================================================
# 2. Provedor: Ollama (100% Local / LLaMA / Nomic / BGE)
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# =============================================================================
# 3. Provedor: Google Gemini
# =============================================================================
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# =============================================================================
# Sobrescritas Globais Opcionais
# =============================================================================
AI_EMBEDDING_DIMENSIONS=1536

# =============================================================================
# Ferramentas Adicionais (Busca Web)
# =============================================================================
TAVILY_API_KEY=
